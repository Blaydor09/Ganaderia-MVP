APP_ENV="development"
NODE_ENV="development"
DATABASE_URL="postgresql://ganaderia_app:local_password@localhost:5433/ganaderia"
# Remote Supabase alternative:
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
PORT=4000
JWT_SECRET="dev_secret"
JWT_REFRESH_SECRET="dev_refresh_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Comma-separated allowed origins.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
TRUST_PROXY="false"
ENABLE_DOCS="true"
REGISTRATION_MODE="open"
# REGISTRATION_CODE="change_me"
TENANT_CREATION_MODE="limited"
MAX_TENANTS_PER_USER="3"
MFA_ENCRYPTION_KEY="local_only_mfa_key_change_before_deploy_123456"
# Optional locally; production requires an HTTPS delivery webhook and strong secret.
# PASSWORD_RESET_DELIVERY_URL="https://mailer.example.com/hooks/password-reset"
# PASSWORD_RESET_DELIVERY_SECRET="local_delivery_secret_change_before_use_123456"
