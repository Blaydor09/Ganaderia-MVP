APP_ENV="production"
NODE_ENV="production"
DATABASE_URL="postgresql://ganaderia_app:password@127.0.0.1:5432/ganaderia"
PORT=4002
HOST="127.0.0.1"
# Generate two different random secrets of at least 32 bytes. Never commit real values.
JWT_SECRET="replace_with_random_value_at_deploy_time"
JWT_REFRESH_SECRET="replace_with_different_random_value_at_deploy_time"
MFA_ENCRYPTION_KEY="replace_with_third_random_value_at_deploy_time"
PASSWORD_RESET_DELIVERY_URL="https://mailer.example.com/hooks/password-reset"
PASSWORD_RESET_DELIVERY_SECRET="replace_with_random_webhook_secret_at_deploy_time"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Comma-separated allowed origins.
CORS_ORIGIN="https://app.example.com,https://admin.example.com"
TRUST_PROXY="true"
ENABLE_DOCS="false"
REGISTRATION_MODE="closed"
# REGISTRATION_CODE="change_me"
TENANT_CREATION_MODE="closed"
MAX_TENANTS_PER_USER="1"
